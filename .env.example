# Copier ce fichier en .env et y mettre vos clés Stripe de test (ne jamais commiter .env).
# sk_test_ : Stripe > Developers > API keys (même compte que le pk_test de frontend/web/.env)
STRIPE_SECRET_KEY=
# whsec_ : affiché par "stripe listen --forward-to localhost:8080/webhooks/stripe"
STRIPE_WEBHOOK_SECRET=
